node_modules/
dist/
coverage/
playwright-report/
test-results/
*.log
.DS_Store

# Local Codex phone/Mac canonical-thread lease. Never commit thread IDs or snapshots.
.codex-handoff.local.json
.codex-handoff.local.lock
.codex-handoff.local.tmp

# Local save/export material
*.psychsim-save.json
*.review-bundle.json
content/generated/*
!content/generated/.gitkeep

# Licensed/fair-use diagnosis classification payloads are local authoring caches.
# Track release metadata/importers, not full code-title catalogs.
content/catalogs/diagnoses/classifications/*/*/terms.json

# Source documents and derived text are private, local-only authoring inputs.
content/source-docs/inbox/*
content/source-docs/processed/*
content/source-docs/archive/*
content/source-docs/quarantine/*
content/source-docs/extracted/*
content/source-docs/manifests/*
!content/source-docs/inbox/.gitkeep
!content/source-docs/processed/.gitkeep
!content/source-docs/archive/.gitkeep
!content/source-docs/quarantine/.gitkeep
!content/source-docs/extracted/.gitkeep
!content/source-docs/manifests/.gitkeep
