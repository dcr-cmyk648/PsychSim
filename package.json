{
  "name": "psychsim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @psychsim/web dev",
    "build": "pnpm --filter @psychsim/web build",
    "postbuild": "node --import tsx tools/content-cli/src/verify-bundle.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx tools/content-cli/src/validate.ts",
    "content:sources:validate": "tsx tools/content-cli/src/validate-source-discovery.ts",
    "content:scan": "tsx tools/content-cli/src/scan-sources.ts",
    "content:extract": "tsx tools/content-cli/src/extract-sources.ts",
    "content:watch": "tsx tools/content-cli/src/watch-sources.ts",
    "content:draft": "tsx tools/content-cli/src/draft-patient.ts",
    "content:review": "tsx tools/content-cli/src/review-content.ts",
    "content:compile": "tsx tools/content-cli/src/compile-review-content.ts",
    "content:impact": "tsx tools/content-cli/src/impact.ts",
    "demo:reference-runs": "tsx tools/content-cli/src/reference-runs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@playwright/test": "1.53.2",
    "@types/node": "24.0.10",
    "chokidar": "4.0.3",
    "eslint": "9.30.1",
    "globals": "16.3.0",
    "mammoth": "1.9.1",
    "pdfjs-dist": "5.4.149",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vitest": "3.2.4"
  }
}
